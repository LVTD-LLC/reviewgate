---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import agentSetupPrompt from "../content/agent-setup-prompt.txt?raw";

const repositoryUrl = "https://github.com/LVTD-LLC/reviewgate";
const siteUrl = "https://reviewgate.lvtd.dev";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "ReviewGate",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "GitHub Actions",
    description:
      "Open-source AI review gates for agent-written pull requests, with a visible 0-5 score and machine-readable findings.",
    url: siteUrl,
    downloadUrl: repositoryUrl,
    isAccessibleForFree: true,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    codeRepository: repositoryUrl,
    license: "https://www.apache.org/licenses/LICENSE-2.0",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "LVTD LLC",
    url: "https://lvtd.dev",
    sameAs: ["https://github.com/LVTD-LLC"],
  },
];

const signalFindings = [
  ["P1", "Release image has no smoke verification", "deployment/Dockerfile"],
  ["P2", "Summary marker must be reused on reruns", "reviewgate-github/src/lib.rs"],
];

const signalLoop = [
  ["01", "Review", "Run focused angles against the latest diff."],
  ["02", "Fix", "Give humans and agents structured findings."],
  ["03", "Push", "Update the same canonical summary."],
  ["04", "Pass", "Reach the fixed 5/5 target."],
];
---

<BaseLayout
  title="ReviewGate - Know when agent code is ready"
  description="ReviewGate is an open-source GitHub Action that scores agent-written pull requests 0-5 and gives humans and coding agents a shared review contract."
  jsonLd={jsonLd}
>
  <main class="concept signal-site">
    <SiteHeader current="product" />

    <section class="signal-hero" aria-label="ReviewGate overview">
      <div class="signal-copy">
        <p class="signal-eyebrow">OPEN-SOURCE CONTROL PLANE / AGENT PRS</p>
        <h1>Merge only at <em>5/5.</em></h1>
        <p class="signal-lede">
          ReviewGate turns every agent-written pull request into a visible score, one living review summary, and a machine-readable fix list.
        </p>
        <div class="signal-actions">
          <a
            class="signal-primary"
            href="/docs"
            data-analytics-event="install_intent_clicked"
            data-analytics-location="homepage_hero"
          >
            Install ReviewGate <span aria-hidden="true">↗</span>
          </a>
          <a
            class="signal-secondary"
            href={repositoryUrl}
            data-analytics-event="source_link_clicked"
            data-analytics-location="homepage_hero"
          >
            View source
          </a>
        </div>
      </div>

      <aside class="signal-console" aria-label="Example ReviewGate result">
        <div class="console-topline">
          <span>PR / 284</span>
          <span>HEAD / 7C31F2A</span>
          <strong>REVIEW COMPLETE</strong>
        </div>

        <div class="console-score">
          <div>
            <span>CONFIDENCE</span>
            <strong>4/5</strong>
          </div>
          <p>HOLD MERGE</p>
        </div>

        <div class="console-meter" aria-label="Score 4 out of 5">
          <span></span><span></span><span></span><span></span><span class="empty"></span>
        </div>

        <div class="console-findings">
          <p>02 SCORE-AFFECTING FINDINGS</p>
          {signalFindings.map(([severity, title, file]) => (
            <div>
              <span>{severity}</span>
              <p>
                <strong>{title}</strong>
                <small>{file}</small>
              </p>
            </div>
          ))}
        </div>

        <div class="console-footer">
          <span>.reviewgate/review.json</span>
          <strong>WAITING FOR PUSH_</strong>
        </div>
      </aside>
    </section>

    <div class="signal-ticker" aria-label="ReviewGate product boundaries">
      <span>RUNS IN YOUR CI</span>
      <span>OPENROUTER BYOK</span>
      <span>NO HOSTED ACCOUNT</span>
      <span>REVIEW-ONLY</span>
      <span>STRUCTURED JSON</span>
    </div>

    <section class="agent-setup" id="agent-setup" aria-labelledby="agent-setup-title">
      <div class="agent-setup-copy">
        <p>SET UP WITH YOUR AI AGENT</p>
        <h2 id="agent-setup-title">One prompt. Local CLI and CI.</h2>
        <p>
          Give your coding agent the complete setup brief. It will ask you to choose a model before touching your repository.
        </p>
        <button
          class="signal-primary agent-copy-button"
          type="button"
          data-copy-agent-prompt
          data-analytics-event="install_intent_clicked"
          data-analytics-location="homepage_agent_setup"
        >
          <span data-copy-label>Copy setup prompt</span>
          <span aria-hidden="true">COPY</span>
        </button>
        <p class="agent-copy-status" data-copy-status aria-live="polite"></p>
      </div>

      <div class="agent-prompt-preview">
        <div class="agent-prompt-topline">
          <span>AGENT SETUP BRIEF</span>
          <span>CLI + GITHUB ACTION</span>
        </div>
        <p>
          Ask for the model first. Suggest <code>openrouter/free</code> or the default <code>deepseek/deepseek-v4-flash</code>.
        </p>
        <details>
          <summary>Read the full prompt</summary>
          <pre data-agent-prompt>{agentSetupPrompt.trim()}</pre>
        </details>
      </div>
    </section>

    <section class="signal-loop" id="signal-loop" aria-label="How ReviewGate works">
      <div class="signal-loop-heading">
        <p>THE CONVERGENCE LOOP</p>
        <h2>Every push has a target.</h2>
      </div>
      <dl>
        {signalLoop.map(([number, title, detail]) => (
          <div>
            <dt><span>{number}</span>{title}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <SiteFooter />
  </main>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-agent-prompt]");
  const promptElement = document.querySelector<HTMLElement>("[data-agent-prompt]");
  const copyLabel = document.querySelector<HTMLElement>("[data-copy-label]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

  const copyPrompt = async (value: string) => {
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(value);
        return;
      } catch {
        // Some embedded browsers expose the API but deny clipboard permission.
      }
    }

    const textarea = document.createElement("textarea");
    textarea.value = value;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.append(textarea);
    textarea.select();
    const legacyDocument = document as unknown as {
      execCommand(command: string): boolean;
    };
    const copied = legacyDocument.execCommand("copy");
    textarea.remove();

    if (!copied) {
      throw new Error("Clipboard access was unavailable");
    }
  };

  copyButton?.addEventListener("click", async () => {
    const prompt = promptElement?.textContent?.trim();

    if (!prompt || !copyLabel || !copyStatus) {
      return;
    }

    copyButton.disabled = true;

    try {
      await copyPrompt(prompt);
      copyLabel.textContent = "Prompt copied";
      copyStatus.textContent = "Paste it into your coding agent to begin.";
      const plausible = (
        window as Window & { plausible?: (event: string) => void }
      ).plausible;
      plausible?.("Agent setup prompt copied");
    } catch {
      copyLabel.textContent = "Copy failed";
      copyStatus.textContent = "Open the full prompt and copy it manually.";
    } finally {
      window.setTimeout(() => {
        copyLabel.textContent = "Copy setup prompt";
        copyStatus.textContent = "";
        copyButton.disabled = false;
      }, 4000);
    }
  });
</script>
