---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "AI Code Review on GitHub: A Merge-Safe Workflow";
const description =
  "Set up AI code review on GitHub with least-privilege Actions, exact-head checks, grounded findings, and a human merge decision.";
const canonical = "https://reviewgate.lvtd.dev/blog/ai-code-review-github/";
const publishedAt = "2026-07-31";

const workflowSteps = [
  {
    name: "Bind the review to a trusted event",
    text: "Use the pull_request event for same-repository pull requests, keep model secrets out of fork and Dependabot runs, and never execute untrusted pull request code in a privileged pull_request_target job.",
  },
  {
    name: "Bind the reviewer to a trusted runtime",
    text: "Run evidence validation and deterministic scoring from a pinned or attested release that the pull request cannot replace, with only the GitHub token permissions the reviewer needs.",
  },
  {
    name: "Bind every blocker to repository evidence",
    text: "Require an exact path, diff side, changed line, excerpt, causal path, and test assessment before an AI finding can affect the merge decision.",
  },
  {
    name: "Bind the verdict to deterministic policy",
    text: "Convert grounded findings into a check result with explicit severity and failure rules instead of letting free-form model prose decide whether a pull request passes.",
  },
  {
    name: "Bind the final result to the current head",
    text: "Publish a structured result for the exact pull request head SHA, supersede older runs, and let humans merge only after the required current-head checks and review obligations are satisfied.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: publishedAt,
    dateModified: publishedAt,
    mainEntityOfPage: canonical,
    author: {
      "@type": "Organization",
      name: "ReviewGate maintainers",
      url: "https://github.com/LVTD-LLC/reviewgate",
    },
    publisher: {
      "@type": "Organization",
      name: "LVTD LLC",
      url: "https://lvtd.dev",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to make AI code review merge-safe on GitHub",
    description:
      "A five-binding workflow for running an AI reviewer without confusing model feedback with merge authority.",
    step: workflowSteps.map((step, index) => ({
      "@type": "HowToStep",
      position: index + 1,
      name: step.name,
      text: step.text,
      url: `${canonical}#binding-${index + 1}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "ReviewGate",
        item: "https://reviewgate.lvtd.dev/",
