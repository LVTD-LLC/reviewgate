---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const title = "Codex Code Review: Turn Findings Into a Merge Gate";
const description =
  "Run Codex code review on GitHub, scope AGENTS.md rules, verify findings, and bind the verdict to the current pull-request head.";
const canonical = "https://reviewgate.lvtd.dev/blog/codex-code-review/";
const publishedAt = "2026-08-04";

const workflowSteps = [
  {
    id: "define-subject",
    name: "Define review scope",
    text: "Describe the pull request intent, changed contracts, expected tests, and repository invariants before asking Codex to review the diff.",
  },
  {
    id: "separate-review",
    name: "Request a separate review",
    text: "Run @codex review on the pull request or enable automatic reviews, using scoped AGENTS.md rules for judgment that deterministic CI cannot express.",
  },
  {
    id: "verify-finding",
    name: "Verify each consequential finding",
    text: "Tie every potential blocker to a changed location, repository evidence, a causal failure path, and an observable contract or test.",
  },
  {
    id: "apply-policy",
    name: "Apply deterministic policy",
    text: "Let repository-owned code decide finding admission, severity, score, and check conclusion instead of parsing the tone of a review comment.",
