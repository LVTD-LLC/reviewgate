---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = [
  {
    href: "/blog/claude-code-review",
    title: "Claude Code Review: Keep Four Roles Separate",
    description:
      "A practical operating model for authors, reviewers, evidence policy, and current-head merge gates.",
    date: "Aug 3, 2026",
    isoDate: "2026-08-03",
  },
  {
    href: "/blog/pull-request-review-comments",
    title: "Pull request review comments: a signal-first guide",
    description:
      "A five-step contract for blockers, evidence, scope, resolution, and current-head review state.",
    date: "Aug 2, 2026",
    isoDate: "2026-08-02",
  },
  {
    href: "/blog/pr-review-prompts",
    title: "PR review prompts for agent-written pull requests",
    description:
      "Eight copy-ready prompts with a concrete evidence and finding-admission contract.",
    date: "Aug 1, 2026",
    isoDate: "2026-08-01",
  },
  {
    href: "/blog/ai-code-review-github",
    title: "AI code review on GitHub: a merge-safe workflow",
    description:
      "A practical guide to least-privilege setup, evidence-bound findings, and exact-head merge checks.",
    date: "Jul 31, 2026",
    isoDate: "2026-07-31",
  },
  {
    href: "/blog/best-ai-code-review-tools",
    title: "Best AI code review tools for agent-written PRs",
    description:
      "A practical guide to score-first, merge-safe review tools and agent repair loops.",
    date: "Jul 30, 2026",
    isoDate: "2026-07-30",
  },
  {
    href: "/blog/how-to-tell-if-code-is-ai-generated",
    title: "How to tell if code is AI-generated: what actually works",
    description:
      "Why style is weak evidence, and the review gate that works regardless of who wrote the diff.",
    date: "Jul 29, 2026",
    isoDate: "2026-07-29",
  },
];
---

<BaseLayout
  title="Engineering field notes - ReviewGate"
  description="Practical field notes on reviewing agent-written pull requests, building reliable review gates, and keeping the human merge decision explicit."
>
  <main class="concept signal-site utility-site">
    <SiteHeader current="blog" />

    <section class="simple-blog" aria-labelledby="blog-heading">
      <header class="simple-blog-header">
        <h1 id="blog-heading">Field notes</h1>
        <p>Practical notes on reviewing agent-written pull requests.</p>
      </header>

      <ol class="simple-post-list" role="list">
        {posts.map((post) => (
          <li>
            <a
              href={post.href}
              data-analytics-event="blog_post_clicked"
              data-analytics-location="blog_quiet_ledger"
            >
              <div class="simple-post-copy">
                <h2>{post.title}</h2>
                <p>{post.description}</p>
              </div>
              <time datetime={post.isoDate}>{post.date}</time>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <SiteFooter />
  </main>
</BaseLayout>
