const description = "Diagnose GitHub required status checks by name, producer, commit, and outcome. Separate missing checks, skipped jobs, and AI reviewer failures.";
const canonical = "https://reviewgate.lvtd.dev/blog/github-required-status-checks/";
const publishedAt = "2026-09-24";
const steps = [
  { name: "Identify the requirement", text: "Record the exact required name and expected producer, not just the workflow title.", anchor: "identity" },
  { name: "Find the evaluated commit", text: "Distinguish the PR head, test merge commit, and merge-group commit.", anchor: "commit" },
  { name: "Trace missing execution", text: "Separate a filtered-out workflow from a job skipped inside an existing run.", anchor: "execution" },
  { name: "Read the actual verdict", text: "Distinguish a completed review with findings from a reviewer that failed to complete.", anchor: "verdict" },
  { name: "Choose the narrow recovery", text: "Repair the responsible trigger, identity, publication, or review failure without erasing the requirement.", anchor: "recovery" },
];
const faqs = [
  { question: "Why are my GitHub required status checks not running?", answer: "Start with the workflow trigger, branch and path filters, skip instructions, and job conditions. Then compare the required name with the published name and confirm the evaluated commit. A workflow excluded by filters can leave a required check pending; a skipped job inside an existing workflow has different behavior." },
  { question: "Does GitHub require status checks to pass before merging?", answer: "When the applicable branch protection or ruleset requires them, the checks must satisfy that rule unless an authorized bypass applies. GitHub accepts success, skipped, and neutral check conclusions in this context. That means a satisfied requirement alone does not prove that every underlying test or review executed." },
  { question: "What is the difference between GitHub statuses and checks?", answer: "Commit statuses and check runs are separate GitHub API resources. Statuses expose a context and state; check runs expose fields including a name, execution status, conclusion, and GitHub App. Inspect both when a required name is ambiguous. If both resources share a required name, GitHub requires both to pass." },
];
