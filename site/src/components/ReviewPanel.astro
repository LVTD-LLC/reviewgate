---
const angles = [
  ["general", "5/5"],
  ["adversarial", "4/5"],
];

const findings = [
  {
    severity: "P1",
    title: "Release image has no smoke verification",
    file: "deployment/Dockerfile",
  },
  {
    severity: "P2",
    title: "Summary marker must be reused on reruns",
    file: "crates/reviewgate-github/src/lib.rs",
  },
];
---

<aside class="review-card" aria-label="Example ReviewGate PR summary">
  <div class="review-card-header">
    <span>GitHub PR summary</span>
    <strong>Updated in place</strong>
  </div>

  <div class="score-block">
    <div>
      <span>Confidence Score</span>
      <strong>4/5</strong>
    </div>
    <p>Needs changes before merge</p>
  </div>

  <div class="score-meter" aria-label="Review score 4 out of 5">
    <span></span>
  </div>

  <div class="summary-box">
    <strong>ReviewGate found two score-affecting risks.</strong>
    <p>Fix the blocking findings, push again, and this same summary comment will update.</p>
  </div>

  <div class="angle-table" aria-label="Review angle scores">
    {angles.map(([name, score]) => (
      <div>
        <span>{name}</span>
        <strong>{score}</strong>
      </div>
    ))}
  </div>

  <ul class="inline-findings" aria-label="Example inline findings">
    {findings.map((finding) => (
      <li>
        <span>{finding.severity}</span>
        <div>
          <strong>{finding.title}</strong>
          <p>{finding.file}</p>
        </div>
      </li>
    ))}
  </ul>

  <div class="artifact-footer">
    <span>.reviewgate/review.json</span>
    <span>{"<!-- reviewgate-summary -->"}</span>
  </div>
</aside>
