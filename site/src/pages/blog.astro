---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const repositoryUrl = "https://github.com/LVTD-LLC/reviewgate";

const firstPost = {
  href: "/blog/how-to-tell-if-code-is-ai-generated",
  number: "NOTE / 001",
  title: "How to tell if code is AI-generated: what actually works",
  description:
    "Why style-based detection is weak evidence, and the five-step review gate that works regardless of who wrote the diff.",
  date: "JUL 29 / 2026",
};
---

<BaseLayout
  title="Engineering field notes - ReviewGate"
  description="Practical field notes on reviewing agent-written pull requests, building reliable review gates, and keeping the human merge decision explicit."
>
  <main class="concept signal-site utility-site">
    <SiteHeader current="blog" />

    <section class="utility-hero" aria-label="ReviewGate field notes">
      <div class="utility-copy">
        <p class="signal-eyebrow">FIELD NOTES / TRANSMISSION 001</p>
        <h1>Notes from the <em>review loop.</em></h1>
        <p class="utility-lede">
          Practical decisions, failure modes, and operating patterns for teams reviewing code written with coding agents.
        </p>
        <div class="signal-actions">
          <a
            class="signal-primary"
            href={firstPost.href}
            data-analytics-event="blog_post_clicked"
            data-analytics-location="blog_hero"
          >
            Read the first field note <span aria-hidden="true">↗</span>
          </a>
          <a
            class="signal-secondary"
            href={repositoryUrl}
            data-analytics-event="source_link_clicked"
            data-analytics-location="blog_hero"
          >View the source</a>
        </div>
      </div>

      <aside class="utility-console" aria-label="Latest field note">
        <div class="console-topline">
          <span>CHANNEL / RG</span>
          <span>POSTS / 01</span>
          <strong>LIVE</strong>
        </div>
        <div class="utility-status">
          <p>LATEST TRANSMISSION</p>
          <strong>001_</strong>
          <span>{firstPost.description}</span>
        </div>
        <a class="blog-entry" href={firstPost.href}>
          <span>{firstPost.number}</span>
          <strong>{firstPost.title}</strong>
          <small>{firstPost.date}</small>
        </a>
        <div class="console-footer">
          <span>/blog</span>
          <strong>STATUS / PUBLISHED</strong>
        </div>
      </aside>
    </section>

    <SiteFooter />
  </main>
</BaseLayout>
