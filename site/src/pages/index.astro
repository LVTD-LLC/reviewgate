---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const repositoryUrl = "https://github.com/LVTD-LLC/reviewgate";

const signalFindings = [
  ["P1", "Release image has no smoke verification", "deployment/Dockerfile"],
  ["P2", "Summary marker must be reused on reruns", "reviewgate-github/src/lib.rs"],
];

const signalLoop = [
  ["01", "Review", "Run focused angles against the latest diff."],
  ["02", "Fix", "Give humans and agents structured findings."],
  ["03", "Push", "Update the same canonical summary."],
  ["04", "Pass", "Reach the fixed 5/5 target."],
];
---

<BaseLayout
  title="ReviewGate - Know when agent code is ready"
  description="ReviewGate is the open-source GitHub Action that scores agent-written pull requests from 0-5 and produces a shared review contract for humans and coding agents."
>
  <main class="concept signal-site">
    <SiteHeader current="product" />

    <section class="signal-hero" aria-label="ReviewGate overview">
      <div class="signal-copy">
        <p class="signal-eyebrow">OPEN-SOURCE CONTROL PLANE / AGENT PRS</p>
        <h1>Merge only at <em>5/5.</em></h1>
        <p class="signal-lede">
          ReviewGate turns every agent-written pull request into a visible score, one living review summary, and a machine-readable fix list.
        </p>
        <div class="signal-actions">
          <a class="signal-primary" href="/docs">Install ReviewGate <span aria-hidden="true">↗</span></a>
          <a class="signal-secondary" href={repositoryUrl}>View source</a>
        </div>
      </div>

      <aside class="signal-console" aria-label="Example ReviewGate result">
        <div class="console-topline">
          <span>PR / 284</span>
          <span>HEAD / 7C31F2A</span>
          <strong>REVIEW COMPLETE</strong>
        </div>

        <div class="console-score">
          <div>
            <span>CONFIDENCE</span>
            <strong>4/5</strong>
          </div>
          <p>HOLD MERGE</p>
        </div>

        <div class="console-meter" aria-label="Score 4 out of 5">
          <span></span><span></span><span></span><span></span><span class="empty"></span>
        </div>

        <div class="console-findings">
          <p>02 SCORE-AFFECTING FINDINGS</p>
          {signalFindings.map(([severity, title, file]) => (
            <div>
              <span>{severity}</span>
              <p>
                <strong>{title}</strong>
                <small>{file}</small>
              </p>
            </div>
          ))}
        </div>

        <div class="console-footer">
          <span>.reviewgate/review.json</span>
          <strong>WAITING FOR PUSH_</strong>
        </div>
      </aside>
    </section>

    <div class="signal-ticker" aria-label="ReviewGate product boundaries">
      <span>RUNS IN YOUR CI</span>
      <span>OPENROUTER BYOK</span>
      <span>NO HOSTED ACCOUNT</span>
      <span>REVIEW-ONLY</span>
      <span>STRUCTURED JSON</span>
    </div>

    <section class="signal-loop" id="signal-loop" aria-label="How ReviewGate works">
      <div class="signal-loop-heading">
        <p>THE CONVERGENCE LOOP</p>
        <h2>Every push has a target.</h2>
      </div>
      <dl>
        {signalLoop.map(([number, title, detail]) => (
          <div>
            <dt><span>{number}</span>{title}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <SiteFooter />
  </main>
</BaseLayout>
