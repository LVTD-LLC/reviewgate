    "dev": "astro dev --host 0.0.0.0",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.6",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "yaml": "2.9.0"
  }
}
